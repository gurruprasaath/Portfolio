  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Stunning Cinematic Scroll Animations */
  @keyframes heroSweepRev {
    from {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
      transform: translateX(-40px);
    }
    to {
      opacity: 1;
      clip-path: inset(-20% -20% -20% -20%);
      transform: translateX(0);
    }
  }
  .hero-sweep {
    animation: heroSweepRev 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
    opacity: 0;
  }
  
  /* 1. Sweep Reveal (Translational Slide) */
  .observe-sweep {
    opacity: 0;
    transform: translateX(-50px);
    filter: blur(5px);
    transition: opacity 1s ease-out, filter 1s ease-out, transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .observe-sweep.visible {
    opacity: 1;
    filter: blur(0px);
    transform: translateX(0);
  }

  /* 2. 3D Perspective Flip */
  .observe-3d-flip {
    opacity: 0;
    transform: perspective(2000px) rotateX(25deg) translateY(60px) scale(0.95);
    transform-style: preserve-3d;
    transition: opacity 1s ease-out, transform 1.2s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .observe-3d-flip.visible {
    opacity: 1;
    transform: perspective(2000px) rotateX(0deg) translateY(0) scale(1);
  }

  /* 3. Elastic Bounce Pop */
  .observe-elastic {
    opacity: 0;
    transform: scale(0.8) translateY(80px);
    transition: opacity 0.8s ease-out, transform 1.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .observe-elastic.visible {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  /* 4. Matrix Motion Blur Slice */
  .observe-matrix {
    opacity: 0;
    filter: blur(20px);
    transform: translate(60px, 60px) skewX(-15deg);
    transition: opacity 1s ease-out, filter 1.2s ease-out, transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .observe-matrix.visible {
    opacity: 1;
    filter: blur(0px);
    transform: translate(0, 0) skewX(0);
  }

  /* 5. Brutalist Heavy Stomp */
  .observe-stomp {
    opacity: 0;
    transform: scale(1.1) translateY(120px);
    filter: brightness(0.5);
    transition: opacity 0.8s ease-in, transform 1s cubic-bezier(0.85, 0, 0.15, 1), filter 1s ease-in;
  }
  .observe-stomp.visible {
    opacity: 1;
    transform: scale(1) translateY(0);
    filter: brightness(1);
  }

  /* Smooth Scrolling */
  html {
