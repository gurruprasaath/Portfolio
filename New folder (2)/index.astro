<style is:global>
  /* Ripple Effect CSS */
  .btn-ripple {
    position: relative;
    overflow: hidden;
  }
  .ripple {
    position: absolute;
    border-radius: 50%;
    transform: scale(0);
    animation: ripple-anim 500ms linear;
    background-color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }
  .bg-secondary .ripple, .border-border .ripple {
    background-color: rgba(0, 0, 0, 0.1);
  }
  @keyframes ripple-anim {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }

  /* Global Click Wave Animation */
  .global-ripple {
    position: fixed;
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0);
    animation: global-ripple-anim 600ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    background-color: transparent;
    border: 2px solid hsl(var(--primary) / 0.6);
    pointer-events: none;
    z-index: 9999;
  }
  @keyframes global-ripple-anim {
    0% {
      width: 0px;
      height: 0px;
      opacity: 1;
      transform: translate(-50%, -50%) scale(0);
    }
    100% {
      width: 100px;
      height: 100px;
      opacity: 0;
      transform: translate(-50%, -50%) scale(1);
    }
  }
</style>

<script>
  // Bulletproof Scroll Bounds Checking
  const animClasses = ['.observe-sweep', '.observe-3d-flip', '.observe-elastic', '.observe-matrix', '.observe-stomp'];
  const animatedElements = document.querySelectorAll(animClasses.join(', '));

  function checkScrollAnimations() {
    const triggerBottom = window.innerHeight * 0.9; // Trigger when top of element hits 90% of screen height
    animatedElements.forEach(el => {
      const box = el.getBoundingClientRect();
      // If the top of the box is above the trigger line, and the bottom of the box is below the top of the screen
      if (box.top < triggerBottom && box.bottom > 0) {
        el.classList.add('visible');
      } else {
        // Remove class when out of view so it animates again next time
        el.classList.remove('visible');
      }
    });
  }

  window.addEventListener('scroll', checkScrollAnimations, { passive: true });
  // Instantly check on load
  checkScrollAnimations();

  // Dynamic Scroll Parallax Elements
  const heroParallax = document.getElementById('hero-parallax-content');
  const aboutDeck = document.getElementById('about-deck');
  const deckCards = document.querySelectorAll('.deck-card');

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        const scrollY = window.scrollY;
        
        // 1. Hero Parallax (Scales Backwards)
        if (heroParallax) {
          const scale = Math.max(0.85, 1 - (scrollY * 0.0005));
          const opacity = Math.max(0, 1 - (scrollY * 0.0015));
          heroParallax.style.transform = `scale(${scale}) translateY(${scrollY * 0.2}px)`;
          heroParallax.style.opacity = opacity;
        }

        // 2. About Deck Scroll Parallax (Fans/Shuffles Background Cards)
        const aboutDeck = document.getElementById('about-deck');
        const deckCards = document.querySelectorAll('.deck-card');
        
        if (aboutDeck && deckCards.length > 0) {
          const rect = aboutDeck.getBoundingClientRect();
          const windowHeight = window.innerHeight;
          
          if (rect.top < windowHeight && rect.bottom > 0) {
            // Calculate progress (0 = bottom edge, 1 = top edge)
            const progress = 1 - (rect.top / windowHeight);
            const clampedProgress = Math.min(Math.max(progress, 0), 1);
            
            deckCards.forEach((card) => {
              const baseScale = parseFloat(card.getAttribute('data-base-scale'));
              const baseRotate = parseFloat(card.getAttribute('data-base-rotate'));
              const spreadMulti = parseFloat(card.getAttribute('data-spread-multi'));
              
              // Dynamic shuffle strength based on scroll position!
              const factor = clampedProgress * 2.5; // Amplified!
              const currentRotate = baseRotate * factor;
              const translateX = spreadMulti * factor * 12; // Massive spread!
              
              card.style.transform = `scale(${baseScale}) rotate(${currentRotate}deg) translateX(${translateX}px)`;
            });
          }
        }
        
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const href = this.getAttribute('href');
      
      if (href === '#') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }
      
      const target = document.querySelector(href);
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Ripple Effect Script
  document.querySelectorAll('.btn-ripple').forEach(button => {
    button.addEventListener('mousedown', function(e) {
      const rect = this.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      const ripple = document.createElement('span');
      ripple.classList.add('ripple');
      
      // Calculate max dimension to ensure ripple covers the button
      const maxDim = Math.max(rect.width, rect.height);
      ripple.style.width = ripple.style.height = `${maxDim}px`;
      ripple.style.left = `${x - maxDim / 2}px`;
      ripple.style.top = `${y - maxDim / 2}px`;
      
      this.appendChild(ripple);
      
      setTimeout(() => ripple.remove(), 500);
    });
  });

  // Global Click Wave Animation
  document.addEventListener('click', function(e) {
    // Avoid double ripple if a button was clicked
    if (e.target.closest('.btn-ripple') || e.target.closest('a')) return;
    
    const wave = document.createElement('div');
    wave.className = 'global-ripple';
    wave.style.left = `${e.clientX}px`;
    wave.style.top = `${e.clientY}px`;
    
    document.body.appendChild(wave);
    
    setTimeout(() => wave.remove(), 600);
  });
</script>

