---
import MainLayout from '../layouts/main.astro';
---

<MainLayout>
  <div class="min-h-screen bg-background text-foreground">
    <!-- Hero Parallax Container -->
    <div class="relative h-[100vh] w-full bg-background z-0">
      <div class="sticky top-0 h-full w-full flex flex-col justify-center overflow-hidden">
        <div id="hero-parallax-content" class="w-full transform origin-center transition-transform duration-75 ease-out will-change-transform">
          <!-- Hero Section (Editorial) -->
          <section class="relative container mx-auto px-6 py-20 min-h-[90vh] flex items-center">
      <div class="max-w-6xl mx-auto relative z-10 w-full">
        <div class="flex flex-col md:flex-row gap-8 lg:gap-12 justify-between items-start md:items-end">
          <div class="md:w-[60%] lg:w-[65%] min-w-0">
            <span class="text-primary font-mono tracking-widest text-sm uppercase mb-6 block hero-sweep">00. Intro</span>
            <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[5rem] xl:text-[6rem] font-black mb-8 font-heading hero-sweep leading-[0.95] tracking-tighter" style="transition-delay: 100ms;">
              <span class="whitespace-nowrap">Gurruprasaath</span><br/><span class="text-primary/90">M K</span>
            </h1>
            
            <div class="flex flex-col sm:flex-row gap-6 mb-12 hero-sweep" style="animation-delay: 200ms;">
              <!-- Creative Custom Status Indicator -->
              <div class="inline-flex items-center gap-3 pr-5 p-1 bg-card/50 backdrop-blur-md border border-border/60 rounded-full shadow-sm">
                <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 text-white shadow-inner">
                  <span class="absolute inset-0 rounded-full bg-emerald-400 animate-ping opacity-30"></span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <div class="flex flex-col">
                  <span class="text-[0.65rem] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest leading-none mb-1">Status</span>
                  <span class="text-sm font-medium text-foreground leading-none">Ready for work</span>
                </div>
              </div>
              
              <!-- Hand-crafted layout line + typography -->
              <div class="flex items-center gap-3">
                <div class="h-[2px] w-8 bg-primary rounded-full"></div>
                <span class="text-sm font-bold tracking-[0.2em] uppercase text-foreground/90">
                  FullStack Developer
                </span>
              </div>
            </div>
          </div>
          
          <div class="md:w-[40%] lg:w-[35%] hero-sweep" style="animation-delay: 300ms;">
            <p class="text-lg md:text-xl text-foreground/80 mb-10 leading-relaxed font-medium">
              I build efficient, user-friendly web applications by bridging modern front-end design with robust back-end architecture. 
              <br><br>
              Obsessed with problem-solving and writing exceptionally clean code.
            </p>
            
            <div class="flex gap-4 flex-col sm:flex-row hero-buttons p-1">
              <a href="#work" class="group relative inline-flex items-center justify-center px-8 py-4 font-bold text-background transition-all duration-300 bg-foreground font-mono rounded-xl hover:-translate-y-1 hover:shadow-xl">
                <span class="relative flex items-center gap-3 text-sm tracking-wide">
                  SEE MY WORK
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </span>
              </a>
              <a href="/resume.pdf" target="_blank" class="inline-flex items-center justify-center px-8 py-4 font-bold text-foreground transition-all duration-300 border-2 border-border font-mono rounded-xl hover:border-foreground hover:-translate-y-1 hover:shadow-xl">
                <span class="text-sm tracking-wide">RESUME</span>
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Subtle background decoration -->
      <div class="absolute top-20 right-10 w-96 h-96 bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="absolute bottom-20 left-10 w-[30rem] h-[30rem] bg-secondary/5 rounded-full blur-[120px] pointer-events-none"></div>
          </section>
        </div>
      </div>
    </div>

    <!-- Rest of Document Stacks over Hero -->
    <div class="relative z-10 bg-background w-full shadow-[0px_-20px_50px_rgba(0,0,0,0.05)] dark:shadow-[0px_-20px_50px_rgba(0,0,0,0.3)]">

    <!-- About Section -->
    <section class="py-24 scroll-section relative overflow-hidden bg-muted/30" id="about">
      <!-- Decorative background blur -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-12 gap-16 items-center">
            
            <!-- Creative Visual Quote Cards -->
            <div class="md:col-span-5 relative observe-sweep">
              <div class="relative w-full aspect-[4/5] max-w-sm mx-auto" id="about-deck">
                <!-- Abstract Background Frames (From Original Aesthetic) -->
                <!-- Frame 1 (Rotates Right) -->
                <div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-transparent rounded-3xl transform transition-transform duration-150 ease-out will-change-transform deck-card opacity-90" data-base-rotate="6" data-base-scale="1.05" data-spread-multi="2.5"></div>
                <!-- Frame 2 (Rotates Left) -->
                <div class="absolute inset-0 border-2 border-primary/10 rounded-3xl transform transition-transform duration-150 ease-out backdrop-blur-sm will-change-transform deck-card opacity-90" data-base-rotate="-6" data-base-scale="1.05" data-spread-multi="-2.5"></div>
                
                <!-- Main Glass Card -->
                <div class="absolute inset-0 bg-background/80 backdrop-blur-xl border border-border/60 rounded-3xl p-8 shadow-2xl flex flex-col justify-between group overflow-hidden deck-card z-10" data-base-rotate="0" data-base-scale="1.0" data-spread-multi="0">
                  <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-secondary transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
                  
                  <div class="relative z-10">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-6 shadow-inner">
                      <svg class="w-6 h-6 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold font-heading mb-3">Code is Poetry</h3>
                    <p class="text-muted-foreground text-sm leading-relaxed">
                      I believe in writing code that isn't just functional, but clean, scalable, and human-readable. Every line is a step toward building something that truly matters.
                    </p>
                  </div>
                  
                  <div class="relative z-10 flex gap-2 flex-wrap">
                    <span class="px-3 py-1 bg-muted rounded-full border border-border/50 text-xs font-medium shadow-sm">Problem Solver</span>
                    <span class="px-3 py-1 bg-muted rounded-full border border-border/50 text-xs font-medium shadow-sm">Continuous Learner</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Text Content Side -->
            <div class="md:col-span-7 observe-sweep" style="transition-delay: 200ms;">
              <span class="text-primary font-mono tracking-widest text-sm uppercase mb-4 block">01. About</span>
              <h2 class="text-5xl md:text-6xl font-black tracking-tighter font-heading mb-8">
                A bit about me.
              </h2>
              
              <div class="space-y-6">
                <p class="text-lg text-foreground/90 leading-relaxed">
                  I'm a FullStack Developer based in Erode, Tamilnadu, working at the intersection of modern front-end and back-end technologies. I'm currently pursuing my B.Tech in Artificial Intelligence and Data Science at Kongu Engineering College.
                </p>
                <p class="text-lg text-foreground/90 leading-relaxed">
                  I hold a strong interest in AI-integrated applications and database management. I focus on building accessible web applications and exploring how AI can enhance the user experience.
                </p>
              </div>
              
              <div class="pt-8 mt-8 border-t border-border/50">
                <p class="text-sm font-semibold text-foreground mb-4">Core Technologies & Tools</p>
                <div class="flex flex-wrap gap-2.5">
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">Python</span>
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">Java</span>
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">C</span>
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">JavaScript</span>
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">React</span>
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">FastAPI</span>
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">Node.js</span>
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">MySQL</span>
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">MongoDB</span>
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">Docker</span>
                  <span class="text-xs px-3 py-1.5 bg-background rounded-md border border-border shadow-sm hover:border-primary/50 transition-colors">Git/GitHub</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Section (Redesigned for Human/Creative Touch) -->
    <section class="py-32 scroll-section relative bg-background" id="experience">
      <div class="container mx-auto px-6">
        
        <!-- Magazine Style Header -->
        <div class="max-w-5xl mx-auto mb-20 flex flex-col md:flex-row md:items-end justify-between gap-8 border-b-2 border-border pb-8">
          <div>
            <span class="text-primary font-mono tracking-widest text-sm uppercase mb-4 block observe-sweep">02. Career</span>
            <h2 class="text-5xl md:text-7xl font-black tracking-tighter observe-sweep font-heading" style="transition-delay: 100ms;">
              Where I've Built.
            </h2>
          </div>
          <div class="max-w-xs observe-sweep" style="transition-delay: 200ms;">
            <p class="text-muted-foreground text-sm font-medium leading-relaxed">I don't just write code. I build interactive AI platforms that solve real-world complexities.</p>
          </div>
        </div>
        
        <!-- Totally Unique Organic Layout -->
        <div class="max-w-5xl mx-auto">
          <div class="relative bg-card rounded-[2rem] md:rounded-[3rem] border border-border/80 shadow-2xl p-8 md:p-12 lg:p-16 overflow-hidden group hover:border-primary/50 transition-colors duration-700 observe-3d-flip">
            
            <!-- Organic Background Element -->
            <div class="absolute top-0 right-0 w-[40rem] h-[40rem] bg-gradient-to-bl from-primary/10 via-secondary/5 to-transparent rounded-full blur-3xl -translate-y-1/3 translate-x-1/3 opacity-60 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
            
            <div class="grid md:grid-cols-12 gap-12 relative z-10 items-center">
              
              <!-- Visually striking left panel -->
              <div class="md:col-span-5 flex flex-col justify-between h-full">
                <div>
                  <div class="inline-block px-4 py-2 bg-foreground text-background font-mono text-xs uppercase tracking-widest rounded-full mb-8 transform -rotate-3 hover:rotate-0 transition-transform cursor-default shadow-md">
                    Current Role
                  </div>
                  <h3 class="text-5xl md:text-6xl font-black mb-4 tracking-tight font-heading text-foreground">PunchBiz</h3>
                  <div class="flex items-center gap-3 text-primary font-bold text-xl mb-12">
                    <svg class="w-6 h-6 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    Fullstack AI Intern
                  </div>
                </div>
                
                <div class="font-mono text-sm text-muted-foreground border-l-2 border-primary/50 pl-5 relative before:absolute before:-left-[5px] before:top-0 before:w-2 before:h-2 before:bg-primary before:rounded-full after:absolute after:-left-[5px] after:bottom-0 after:w-2 after:h-2 after:bg-primary after:rounded-full">
                  <p class="mb-1 uppercase tracking-wider text-xs">Commenced</p>
                  <p class="font-bold text-foreground text-lg">JUN 2025</p>
                  <p class="mt-6 mb-1 uppercase tracking-wider text-xs">Status</p>
                  <p class="flex items-center gap-2 font-bold text-emerald-500 text-lg">
                    <span class="relative flex h-3 w-3">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                    </span>
                    PRESENT
                  </p>
                </div>
              </div>
              
              <!-- Content rich right panel -->
              <div class="md:col-span-7 md:pl-8">
                <div class="prose prose-lg dark:prose-invert max-w-none">
                  <p class="text-xl leading-relaxed text-foreground/90 font-medium mb-10">
                    Spearheading the development of <strong class="text-foreground">MockMentorBiz</strong>, 
                    a next-generation interview simulation platform powered exclusively by advanced AI models.
                  </p>
                  
                  <ul class="space-y-8 list-none pl-0">
                    <li class="relative pl-10 text-lg text-muted-foreground leading-relaxed">
                      <span class="absolute left-0 top-2 w-3 h-3 rounded bg-primary/20 ring-4 ring-primary/10 flex items-center justify-center"><span class="w-1 h-1 bg-primary rounded-full"></span></span>
                      Engineering resilient full-stack architecture that seamlessly integrates <strong class="text-foreground">Groq LLM (GPT-OSS-120B)</strong> to provide ultra-fast real-time tailored question generation and deep resume analysis.
                    </li>
                    <li class="relative pl-10 text-lg text-muted-foreground leading-relaxed">
                      <span class="absolute left-0 top-2 w-3 h-3 rounded bg-secondary/20 ring-4 ring-secondary/10 flex items-center justify-center"><span class="w-1 h-1 bg-secondary rounded-full"></span></span>
                      Collaborating closely within an agile 4-member squad to architect automated parsing algorithms and an immersive, realistic UI/UX simulation interface.
                    </li>
                  </ul>
                </div>
                
                <!-- Micro-interaction brutalist button -->
                <div class="mt-12 pt-8 border-t border-border/50">
                  <a href="https://mockmentorbiz.punchbiz.co/" target="_blank" class="group relative inline-flex items-center justify-center px-8 py-4 font-bold text-background transition-all duration-300 bg-foreground font-mono rounded-2xl hover:shadow-[0_10px_40px_-10px_rgba(0,0,0,0.3)] dark:hover:shadow-[0_10px_40px_-10px_rgba(255,255,255,0.2)] hover:-translate-y-1 overflow-hidden">
                    <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-[ripple-anim_1.5s_ease-in-out_infinite]"></span>
                    <span class="relative flex items-center gap-3 text-sm tracking-wide">
                      VIEW LIVE PLATFORM
                      <svg class="w-5 h-5 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h7"></path></svg>
                    </span>
                  </a>
                </div>
              </div>
              
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Work Section -->
    <section class="py-24 scroll-section bg-muted/30" id="work">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="mb-16 observe-sweep">
            <p class="text-sm uppercase tracking-wider text-muted-foreground mb-3">Selected work</p>
            <h2 class="text-4xl md:text-5xl font-bold font-heading">
              Things I've built
            </h2>
          </div>
          
          <div class="space-y-24">
            <!-- Project 1 -->
            <div class="grid md:grid-cols-12 gap-8 items-center observe-elastic">
              <div class="md:col-span-7 order-2 md:order-1">
                <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-950/20 dark:to-indigo-950/20 rounded-2xl p-8 aspect-video flex items-center justify-center border border-border">
                  <div class="w-full max-w-sm">
                    <div class="bg-white dark:bg-card rounded-lg shadow-xl p-4">
                      <div class="flex gap-2 mb-3">
                        <div class="w-2 h-2 rounded-full bg-red-400"></div>
                        <div class="w-2 h-2 rounded-full bg-yellow-400"></div>
                        <div class="w-2 h-2 rounded-full bg-green-400"></div>
                      </div>
                      <div class="space-y-3">
                        <div class="h-2 bg-muted rounded w-3/4"></div>
                        <div class="h-2 bg-muted rounded w-full"></div>
                        <div class="h-20 bg-gradient-to-br from-primary/20 to-secondary/20 rounded"></div>
                        <div class="grid grid-cols-2 gap-2">
                          <div class="h-12 bg-muted rounded"></div>
                          <div class="h-12 bg-muted rounded"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="md:col-span-5 order-1 md:order-2">
                <div class="space-y-4">
                  <div>
                    <h3 class="text-2xl md:text-3xl font-bold font-heading mb-3">VoiceControlled IDE</h3>
                    <p class="text-muted-foreground leading-relaxed">
                      Voice-controlled IDE that enables hands-free coding with speech-to-text, AI-powered code generation, auto-scroll, and real-time feedback for people with motor disabilities.
                    </p>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    <span class="text-xs px-3 py-1 bg-muted rounded-full">React</span>
                    <span class="text-xs px-3 py-1 bg-muted rounded-full">FastAPI</span>
                    <span class="text-xs px-3 py-1 bg-muted rounded-full">Python</span>
                    <span class="text-xs px-3 py-1 bg-muted rounded-full">Whisper</span>
                    <span class="text-xs px-3 py-1 bg-muted rounded-full">MongoDB</span>
                  </div>
                  <a href="https://github.com/Alwin1605-lab/Codevoice_" target="_blank" class="inline-flex items-center gap-2 text-sm text-primary hover:gap-3 transition-all">
                    View on GitHub
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>

            <!-- Project 2 -->
            <div class="grid md:grid-cols-12 gap-8 items-center observe-elastic">
              <div class="md:col-span-5">
                <div class="space-y-4">
                  <div>
                    <h3 class="text-2xl md:text-3xl font-bold font-heading mb-3">AI Study Buddy</h3>
                    <p class="text-muted-foreground leading-relaxed">
                      Generates MCQs, extracts units, and creates structured study content using LLaMA models with a FastAPI backend.
                    </p>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    <span class="text-xs px-3 py-1 bg-muted rounded-full">React</span>
                    <span class="text-xs px-3 py-1 bg-muted rounded-full">FastAPI</span>
                    <span class="text-xs px-3 py-1 bg-muted rounded-full">Groq LLaMA</span>
                    <span class="text-xs px-3 py-1 bg-muted rounded-full">MongoDB</span>
                  </div>
                  <a href="https://github.com/gurruprasaath/Ai-Study-buddy" target="_blank" class="inline-flex items-center gap-2 text-sm text-primary hover:gap-3 transition-all">
                    View on GitHub
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </a>
                </div>
              </div>
              
              <div class="md:col-span-7">
                <div class="bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-950/20 dark:to-teal-950/20 rounded-2xl p-8 aspect-video flex items-center justify-center border border-border">
                  <div class="w-40">
                    <div class="bg-white dark:bg-card rounded-3xl shadow-2xl p-3 border-8 border-gray-800 dark:border-gray-200">
                      <div class="space-y-3">
                        <div class="h-1 bg-muted rounded w-20 mx-auto"></div>
                        <div class="h-16 bg-gradient-to-br from-emerald-400 to-teal-400 rounded-xl"></div>
                        <div class="space-y-2">
                          <div class="h-1.5 bg-muted rounded w-full"></div>
                          <div class="h-1.5 bg-muted rounded w-3/4"></div>
                        </div>
                        <div class="grid grid-cols-3 gap-2 pt-2">
                          <div class="h-8 bg-muted rounded"></div>
                          <div class="h-8 bg-muted rounded"></div>
                          <div class="h-8 bg-muted rounded"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Project 3 -->
            <div class="grid md:grid-cols-12 gap-8 items-center observe-elastic">
              <div class="md:col-span-7 order-2 md:order-1">
                <div class="bg-gradient-to-br from-violet-50 to-purple-50 dark:from-violet-950/20 dark:to-purple-950/20 rounded-2xl p-8 aspect-video flex items-center justify-center border border-border">
                  <!-- Floating Browser Window framing the live application -->
                  <div class="w-full max-w-xl aspect-[16/10] bg-background rounded-xl shadow-2xl overflow-hidden border border-border flex flex-col hover:scale-[1.02] transition-transform duration-500">
                    <!-- Browser Chrome Bar -->
                    <div class="bg-muted/50 border-b border-border px-4 py-2 flex items-center gap-2">
                      <div class="flex gap-1.5">
                        <div class="w-3 h-3 rounded-full bg-red-400/80"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-400/80"></div>
                        <div class="w-3 h-3 rounded-full bg-green-400/80"></div>
                      </div>
                      <div class="mx-auto bg-background/50 text-[10px] sm:text-xs text-muted-foreground px-3 py-1 rounded-md font-mono truncate max-w-[150px] sm:max-w-xs">
                        ai-call-intelligence.vercel.app
                      </div>
                      <div class="w-12"></div> <!-- Spacer for flex centering -->
                    </div>
                    <!-- The Interactive Iframe -->
                    <iframe src="https://ai-call-intelligence.vercel.app" class="w-full flex-1 border-0 bg-background" loading="lazy" title="AI Call Intelligence Demo" sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
                  </div>
                </div>
              </div>
              
              <div class="md:col-span-5 order-1 md:order-2">
                <div class="space-y-4">
                  <div>
                    <h3 class="text-2xl md:text-3xl font-bold font-heading mb-3">AI Call Intelligence</h3>
                    <p class="text-muted-foreground leading-relaxed">
                      Call analysis system with transcription, sentiment scoring, and automated conversation summaries using LLMs and ASR.
                    </p>
